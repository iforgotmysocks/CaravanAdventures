<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CaravanAdventures</RootNamespace>
    <AssemblyName>CaravanAdventures</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(MSBuildProjectDirectory)/../../../../..</RimWorldManagedDir>
    <ModAssembliesDir Condition="'$(ModAssembliesDir)' == ''">$(MSBuildProjectDirectory)/../../../1.7/Assemblies</ModAssembliesDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldManagedDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldManagedDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(HarmonyAssemblyPath)' == ''">
    <PackageReference Include="Lib.Harmony" Version="2.4.3" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(HarmonyAssemblyPath)' != ''">
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../../About/About.xml" Link="About.xml" />
    <None Include="../../../README.md" Link="README.md" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RimWorldManagedDir)/Assembly-CSharp.dll')"
           Text="Game assemblies are missing. Set RimWorldManagedDir to the directory containing RimWorld 1.7's Assembly-CSharp.dll." />
    <Error Condition="!Exists('$(RimWorldManagedDir)/UnityStubs.dll') or !Exists('$(RimWorldManagedDir)/Waylith.dll')"
           Text="RimWorld 1.7 engine assemblies are missing. RimWorldManagedDir must also contain UnityStubs.dll and Waylith.dll." />
    <Error Condition="'$(HarmonyAssemblyPath)' != '' and !Exists('$(HarmonyAssemblyPath)')"
           Text="HarmonyAssemblyPath does not point to an existing 0Harmony.dll." />
  </Target>

  <Target Name="CopyModAssembly" AfterTargets="Build">
    <MakeDir Directories="$(ModAssembliesDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModAssembliesDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
